{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d frontend && npm run dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d backend && php artisan serve --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend-compilado",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d frontend && npm run build && npx vite preview --port 4173 --strictPort"],
      "port": 4173
    }
  ]
}
