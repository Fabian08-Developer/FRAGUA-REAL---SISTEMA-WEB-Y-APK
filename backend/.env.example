APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Revisión por rol (13/10/2026): en español, para que los mensajes de validación salgan de
# lang/es/validation.php (con "en" el Cliente y el Mesero los veían en inglés).
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fase 3, tarea 4: politica de sesiones (minutos). Una sesion se cierra sola tras este tiempo
# sin usarse, y como maximo a la duracion indicada aunque se use a diario.
FRAGUA_REAL_SESION_INACTIVIDAD_MINUTOS=10080
FRAGUA_REAL_SESION_DURACION_MAXIMA_MINUTOS=43200

# Fase 5, tarea 1: datos del negocio en el comprobante de pago. El NIT queda vacio hasta tenerlo;
# vacio, el comprobante no lo imprime.
FRAGUA_REAL_NOMBRE="Fragua Real Burger"
FRAGUA_REAL_NIT=
FRAGUA_REAL_DIRECCION="Esquina frente al malecón turístico, etapa 1"
FRAGUA_REAL_TELEFONO="322 725 9965"

# Fase 6, tarea 1 (D4): pasarela de pago. "manual" = el Mesero o el Administrador aprueban el pago
# en línea a mano (respaldo). "wompi" = confirmación automática con las llaves de abajo.
# En Wompi > Desarrolladores > Eventos, la URL de eventos es: https://<tu-dominio>/api/pasarela/wompi/eventos
PASARELA_PROVEEDOR=manual
PASARELA_MINUTOS_CHECKOUT=30
PASARELA_EVENTOS_MAX_HORAS=72
WOMPI_AMBIENTE=sandbox
WOMPI_LLAVE_PUBLICA=
WOMPI_LLAVE_PRIVADA=
WOMPI_SECRETO_EVENTOS=
WOMPI_SECRETO_INTEGRIDAD=

# Endurecimiento: orígenes extra que pueden llamar la API desde un navegador (además de FRONTEND_URL),
# separados por coma. Vacío en una instalación normal (sitio y API en el mismo dominio).
CORS_ORIGENES=
